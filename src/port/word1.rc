#include <windows.h>

1 RT_MANIFEST "winword.manifest"
201 BITMAP "assets\\word95-toolbar.bmp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft (historical source)"
            VALUE "FileDescription", "WORD1 original Opus x64 port"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "WORD1"
            VALUE "OriginalFilename", "WORD1.exe"
            VALUE "ProductName", "Microsoft Word/Opus x64 Source Port"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
